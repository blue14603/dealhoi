# ---------------------------------------------------------------------------
# DealHoi environment variables. Copy to .env.local for local development.
# NEVER commit real credentials. All of these are server-side only.
# ---------------------------------------------------------------------------

# PostgreSQL connection (Supabase: Project Settings → Database → Connection string).
# Use the transaction pooler URL (port 6543) on Vercel. Required.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dealhoi
# Set to true for Supabase / any managed database that requires TLS.
DATABASE_SSL=false
# Role used for public read queries so Row Level Security applies ("anon" on Supabase).
# Leave empty to disable role switching.
DB_PUBLIC_ROLE=anon

# Show fictional demonstration data. Defaults: true in development, false in production.
DEALHOI_DEMO_DATA=true
# Days after which a source verification is flagged as stale.
DEALHOI_STALE_AFTER_DAYS=90
# Optional compatibility score weights (percent).
# DEALHOI_SCORING_WEIGHTS={"categoryAlignment":40,"spendingConditions":25,"rewardAlignment":20,"annualFee":15}

# OpenAI (server-side only). Without a key the app still works; AI features show an error state.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_MS=20000
OPENAI_MAX_OUTPUT_TOKENS=900
AI_RATE_LIMIT_PER_MINUTE=12

# Admin authentication -------------------------------------------------------
# Random secret of at least 32 characters used to sign admin session cookies:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=
# Provider: "supabase" (Supabase Auth + admin_users table) or "env" (single admin below).
# Defaults to "supabase" when SUPABASE_URL and SUPABASE_ANON_KEY are set, otherwise "env".
ADMIN_AUTH_PROVIDER=env
# For ADMIN_AUTH_PROVIDER=env. Generate the hash with: npm run admin:hash-password -- 'a-long-password'
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# For ADMIN_AUTH_PROVIDER=supabase (Project Settings → API).
SUPABASE_URL=
SUPABASE_ANON_KEY=
